OPENAI_API_KEY=sk-...
# Optional: override the image model (defaults to gpt-image-2.5-flare)
JAGIMAGE_MODEL=gpt-image-2.5-flare
# For --provider gemini (Google AI Studio key)
GEMINI_API_KEY=...
# Optional: override the Gemini image model (default gemini-3-pro-image)
JAGIMAGE_GEMINI_MODEL=gemini-3-pro-image
